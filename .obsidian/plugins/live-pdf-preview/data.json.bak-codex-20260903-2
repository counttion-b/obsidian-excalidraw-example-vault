-sandbox .pdf-preview-page .el-h6,\n#pdf-preview-sandbox .pdf-preview-page h6 {\n  height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  overflow: hidden !important;\n}\n\n#pdf-preview-sandbox .pdf-preview-page .el-h6 h6 {\n  font-size: 0.01px !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n#pdf-preview-sandbox .pdf-preview-page .callout[data-callout=\"ti\"] {\n  counter-increment: ti;\n  background: transparent !important;\n  border: none !important;\n  border-left: none !important;\n  box-shadow: none !important;\n  padding: 0 !important;\n  margin: 14px 0 !important;\n}\n\n#pdf-preview-sandbox .pdf-preview-page .callout[data-callout=\"ti\"] .callout-title {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  padding: 0 !important;\n  margin: 0 0 6px 0 !important;\n  font-weight: 700;\n  font-size: 1.05em;\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  color: var(--lambda-black) !important;\n}\n\n#pdf-preview-sandbox .pdf-preview-page .callout[data-callout=\"ti\"] .callout-title .callout-title-inner::before {\n  content: counter(ti) \".\" !important;\n  font-weight: 900 !important;\n  margin-right: 0.35em !important;\n  color: var(--lambda-orange) !important;\n}\n\n#pdf-preview-sandbox .pdf-preview-page .callout[data-callout=\"ti\"] .callout-icon {\n  display: none !important;\n}\n\n#pdf-preview-sandbox .pdf-preview-page .callout[data-callout=\"ti\"] .callout-title em {\n  color: var(--lambda-gray) !important;\n  font-style: normal !important;\n  font-weight: 400;\n  font-size: 0.9em;\n}\n\n#pdf-preview-sandbox .pdf-preview-page .callout[data-callout=\"ti\"] .callout-content {\n  background: transparent !important;\n  border: none !important;\n  padding: 0 !important;\n  margin: 0 !important;\n  font-size: 1em;\n  line-height: 1.9;\n}\n\n#pdf-preview-sandbox .pdf-preview-page .callout[data-callout=\"ti\"]:not(:has(.callout[data-callout^=\"opts\"])) {\n  paddin